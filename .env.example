# ============================================================
# 脑卒中疾病管理医疗系统 — 环境变量
# 使用方式: docker compose --env-file .env up -d
# ============================================================

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE_PREFIX=stroke

# Redis
REDIS_PASSWORD=

# JWT 密钥（生产环境替换为 256 位密钥）
JWT_SECRET=stroke-dev-jwt-secret-key-2026-must-be-256-bit

# 服务端口
CLINICAL_PORT=8081
INFRA_PORT=8082
INTEGRATION_PORT=8083
REHAB_PORT=8084
ANALYTICS_PORT=8085
GATEWAY_PORT=8080
FRONTEND_PORT=80
